# Free-tier LLM keys (no paid AI is used)
# Groq: https://console.groq.com/keys     Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-lite-latest
LLM_ORDER=groq,gemini

# Local: SQLite file. Hosted: a free Postgres (e.g. Neon) -> the connection string exactly as Neon shows it (postgresql://...)
DATABASE_URL=sqlite:///./signalstack.db

# Shared secret for the GitHub Actions cron that triggers weekly briefs / monthly audits on free hosts
CRON_TOKEN=change-me
ENABLE_SCHEDULER=1
FRONTEND_ORIGINS=http://localhost:5173
